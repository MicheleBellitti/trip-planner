# Backend settings for local development. Copy to backend/.env (gitignored) and fill in.
# Read by app/config.py (Settings); real environment variables win over this file.
# On Railway the same variables are set in the service, without ENVIRONMENT/AUTH_MODE overrides.

# development or production; unset means production. AUTH_MODE=local only starts in development.
ENVIRONMENT=development

# Anthropic DEVELOPMENT key (never the production one on a laptop). Only needed to run a real
# Managed Agents session; tests and the fake client work without it. Required in production.
ANTHROPIC_API_KEY=

# Anthropic Workload Identity Federation: what the CI eval jobs use instead of a key (development
# only; production refuses to start without ANTHROPIC_API_KEY). Leave empty locally. A set
# ANTHROPIC_API_KEY wins. The SDK reads these from the process environment (CI sets them, with
# docs/deploy.md "Anthropic Workload Identity Federation"), so a value here is not enough.
# Path of the file holding the identity (OIDC) token; ANTHROPIC_IDENTITY_TOKEN may hold it instead.
ANTHROPIC_IDENTITY_TOKEN_FILE=
ANTHROPIC_IDENTITY_TOKEN=
# The federation rule and organization the token is exchanged under (required for federation).
ANTHROPIC_FEDERATION_RULE_ID=
ANTHROPIC_ORGANIZATION_ID=
# Optional: the workspace the exchanged credential is scoped to.
ANTHROPIC_WORKSPACE_ID=

# Postgres for plans, events and fx_rates. postgres:// and postgresql:// are accepted and
# rewritten to postgresql+asyncpg://. This one matches docker-compose.yml; with a local
# Homebrew Postgres use postgresql://localhost:5432/trip_planner_dev instead.
DATABASE_URL=postgresql://trip_planner:trip_planner@localhost:5432/trip_planner_dev

# Which agent roster (and lockfile) to drive: development = Haiku subagents and a Sonnet
# coordinator, cents per run. Always development locally; production only for final checks.
# Required when ENVIRONMENT=production (the backend refuses to start without it).
AGENT_PROFILE=development

# Managed Agents budget per session, in US cents: the session pauses (budget_paused) at the
# limit. Empty = the profile's default: 100 ($1) for development, 400 ($4) for production.
SESSION_BUDGET_CENTS=100

# Monthly spend ceiling across all plans, in cents (recorded cost plus the unspent budget of the
# running plans): POST /plans refuses a plan whose budget would not fit under it.
MONTHLY_LIMIT_CENTS=5000

# Per-user monthly quota (calendar month, Europe/Rome): plans one account may start, and cents
# its plans may use (recorded cost plus the unspent budget of its running plans). Admins
# (ADMIN_EMAILS) are exempt; the ceiling above still applies to them. GET /me shows the month.
USER_MONTHLY_PLANS=10
USER_MONTHLY_CENTS=1500

# How many times "Continua" may raise one plan's budget (each adds $2); 0 disables the button.
MAX_CONTINUES_PER_PLAN=2

# How many plans may run at once, all users: past it POST /plans answers 503 planner_busy.
MAX_RUNNING_PLANS=8

# Rate limits kept in the process (one replica; a redeploy starts them over): POST /plans per
# user and per client IP within the window, and event streams (SSE) open at once per user.
PLAN_CREATE_LIMIT_PER_USER=5
PLAN_CREATE_LIMIT_PER_IP=20
PLAN_CREATE_WINDOW_SECONDS=600
MAX_STREAMS_PER_USER=4

# Read the client IP from X-Forwarded-For (its last value, the one the proxy appended) rather
# than the socket. Empty = on in production (Railway's proxy), off in development. Never on
# without a proxy in front, never off behind Railway (uvicorn's --proxy-headers then hands the
# app the client's own leftmost value): either way a client could pick its own bucket.
TRUST_PROXY_HEADERS=

# Who may use the planner with AUTH_MODE=triptracker, comma separated. Empty means nobody. With
# AUTH_MODE=local the first address is the signed-in user. Not consulted with AUTH_MODE=atlas:
# there the web app decides who may sign up (AUTH_ALLOWED_EMAILS) and every account may plan.
PLANNER_ALLOWED_EMAILS=dev@example.com

# The admin role: who may read the eval history (GET /evals/runs*), comma separated. Empty means
# everyone in PLANNER_ALLOWED_EMAILS with AUTH_MODE=triptracker or local (the one-user setup),
# and nobody with AUTH_MODE=atlas.
ADMIN_EMAILS=

# The planner web app origin: the only CORS origin and the required Origin header on POST.
FRONTEND_ORIGIN=http://localhost:3000

# TripTracker origin: session verification (AUTH_MODE=triptracker), trip.json schema download,
# and the extra CORS origin for GET /plans/{id}/trip used by /import.
TRIPTRACKER_ORIGIN=https://viaggi.bellittim.com

# Who says who the user is. triptracker = TripTracker's Better Auth cookie, verified at
# TRIPTRACKER_ORIGIN (the original one-user setup). atlas = the web app's own accounts (its
# Better Auth, cookie prefix `atlas`), verified against the auth_sessions table of this database;
# every account may plan, and new plans store the user's id in plans.user_id. local = no login,
# the user is the first PLANNER_ALLOWED_EMAILS entry; refused unless ENVIRONMENT=development.
AUTH_MODE=local

# The profile's lockfile written by `ant apply --lock-file` (agent, environment and skill IDs).
# Empty = backend/claude-lock.<AGENT_PROFILE>.json, which ships with the backend on Railway.
LOCKFILE_PATH=

# TripTracker's Trip JSON Schema, used to validate every produced Trip.
# Empty = TRIPTRACKER_ORIGIN/schema/trip.json.
TRIP_SCHEMA_URL=

# structlog JSON log level: DEBUG, INFO, WARNING, ERROR or CRITICAL.
LOG_LEVEL=DEBUG

# Bearer token of POST /evals/runs, the machine endpoint the CI eval job uploads its results to
# (the eval history page reads them back). Empty = the endpoint is disabled (404). Use a long
# random value (openssl rand -hex 32); the same value is the GitHub secret EVALS_INGEST_TOKEN.
EVALS_INGEST_TOKEN=

# Contact sent in the User-Agent of the Wikimedia requests that fetch destination cover photos
# (app/covers.py; Wikimedia's policy asks for a way to reach the operator): an https:// page or
# a mailto: address. Empty = FRONTEND_ORIGIN. Only the destination name is sent to Wikimedia.
WIKIMEDIA_CONTACT_URL=

# Check every URL of a delivered plan (GET with an AtlasLinkCheck User-Agent, public addresses
# only): a dead page becomes its site's homepage or plain text. false = no check, no request.
LINK_CHECK_ENABLED=true

# Local demo for UI work (development only: Settings refuses it in production). POST
# /plans replays a scripted session from tests/fixtures/ma through the fake Managed Agents
# client: no API key, no lockfile, no network, no cost. POST /plans?demo_scenario=<name> picks
# the scenario (default happy_path; also rejected_then_accepted, three_rejections_failed,
# budget_reached, requires_action_blocked, end_turn_without_plan, mcp_failure, interrupt,
# redelegation, ...); budget_reached waits for "Continua", interrupt for "Interrompi".
# Demo plans live only as long as the server process. One line, from the repository root
# (migrate the database once first: `uv run alembic upgrade head` with the same DATABASE_URL):
#   cd backend && ENVIRONMENT=development AUTH_MODE=local DEMO_MODE=true PLANNER_ALLOWED_EMAILS=michele@example.com FRONTEND_ORIGIN=http://localhost:3000 DATABASE_URL=postgresql://localhost:5432/trip_planner_dev uv run uvicorn app.main:app --port 8000
DEMO_MODE=false

# Demo pacing: 1.0 = the scenario's recorded pace (happy_path takes about 75 s), 2.0 twice as
# slow, 0.2 five times faster. Read only when DEMO_MODE=true.
DEMO_PACE=1.0

# The backend's git sha, recorded in plans.agent_versions. Railway sets RAILWAY_GIT_COMMIT_SHA
# by itself (the build has no .git); locally, leave both unset and `git rev-parse` is used.
# GIT_SHA=

# Not read from this file: the test suite takes TEST_DATABASE_URL from the shell environment
# (default postgresql+asyncpg://localhost:5432/trip_planner_test). With docker compose, export
# TEST_DATABASE_URL=postgresql+asyncpg://trip_planner:trip_planner@localhost:5432/trip_planner_test

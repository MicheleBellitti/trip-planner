{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "watchPatterns": ["/backend/**"]
  },
  "deploy": {
    "startCommand": "python -m app.jobs cleanup",
    "cronSchedule": "0 1 * * *",
    "preDeployCommand": null,
    "healthcheckPath": null,
    "restartPolicyType": "NEVER",
    "numReplicas": 1
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "destinationName": {
      "type": "string",
      "maxLength": 200
    },
    "timezone": {
      "type": "string",
      "minLength": 1
    },
    "startDate": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "endDate": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "baseName": {
      "type": "string",
      "maxLength": 200
    },
    "baseAddress": {
      "type": "string",
      "maxLength": 300
    },
    "baseLat": {
      "type": "number",
      "minimum": -90,
      "maximum": 90
    },
    "baseLon": {
      "type": "number",
      "minimum": -180,
      "maximum": 180
    },
    "notes": {
      "type": "string",
      "maxLength": 4000
    },
    "coverSeed": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "icsSequence": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "days": {
      "maxItems": 120,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "tripId": {
            "type": "string",
            "minLength": 1
          },
          "date": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "dayIndex": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "title": {
            "type": "string",
            "maxLength": 120
          },
          "notes": {
            "type": "string",
            "maxLength": 4000
          },
          "stops": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "dayId": {
                  "type": "string",
                  "minLength": 1
                },
                "title": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 120
                },
                "kind": {
                  "type": "string",
                  "enum": [
                    "activity",
                    "meal",
                    "transfer",
                    "rest"
                  ]
                },
                "startTime": {
                  "type": "string",
                  "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
                },
                "durationMin": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                },
                "locationName": {
                  "type": "string",
                  "maxLength": 200
                },
                "address": {
                  "type": "string",
                  "maxLength": 300
                },
                "lat": {
                  "type": "number",
                  "minimum": -90,
                  "maximum": 90
                },
                "lon": {
                  "type": "number",
                  "minimum": -180,
                  "maximum": 180
                },
                "url": {
                  "type": "string",
                  "maxLength": 2000
                },
                "notes": {
                  "type": "string",
                  "maxLength": 4000
                },
                "sortOrder": {
                  "type": "number"
                },
                "state": {
                  "type": "string",
                  "enum": [
                    "planned",
                    "done",
                    "skipped"
                  ]
                }
              },
              "required": [
                "id",
                "dayId",
                "title",
                "kind",
                "sortOrder",
                "state"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "id",
          "tripId",
          "date",
          "dayIndex",
          "stops"
        ],
        "additionalProperties": false
      }
    },
    "bookings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "tripId": {
            "type": "string",
            "minLength": 1
          },
          "stopId": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "vendor": {
            "type": "string",
            "maxLength": 200
          },
          "kind": {
            "type": "string",
            "enum": [
              "restaurant",
              "wellness",
              "ticket",
              "parking",
              "transport",
              "lodging",
              "activity",
              "other"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "to_book",
              "booked",
              "confirmed",
              "cancelled"
            ]
          },
          "dueAt": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}T([01]\\d|2[0-3]):[0-5]\\d(:[0-5]\\d)?(\\.\\d+)?(Z|[+-]([01]\\d|2[0-3]):[0-5]\\d)$"
          },
          "scheduledFor": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}T([01]\\d|2[0-3]):[0-5]\\d(:[0-5]\\d)?(\\.\\d+)?(Z|[+-]([01]\\d|2[0-3]):[0-5]\\d)$"
          },
          "leadDays": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "confirmationRef": {
            "type": "string",
            "maxLength": 120
          },
          "phone": {
            "type": "string",
            "maxLength": 40
          },
          "url": {
            "type": "string",
            "maxLength": 2000
          },
          "costCents": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "notes": {
            "type": "string",
            "maxLength": 4000
          },
          "sortOrder": {
            "type": "number"
          }
        },
        "required": [
          "id",
          "tripId",
          "title",
          "kind",
          "status",
          "sortOrder"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "id",
    "title",
    "destinationName",
    "timezone",
    "startDate",
    "endDate",
    "coverSeed",
    "days",
    "bookings"
  ],
  "additionalProperties": false
}

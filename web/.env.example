# Planner web app settings for local development. Copy to web/.env.local (gitignored).
# NEXT_PUBLIC_* values are inlined into the browser bundle at build time: never put a secret here
# (the Anthropic key lives only in the backend).

# Base URL of the planner backend (FastAPI): every fetch and the SSE stream go here, with
# credentials: "include". Production: https://atlas.api.bellittim.com
# Locally this is the backend of backend/.env.example (AUTH_MODE=local, so no login), also in
# its offline demo (DEMO_MODE=true, README.md "Offline demo"). The backend's FRONTEND_ORIGIN
# must be this app's origin (http://localhost:3000), or CORS and the Origin check refuse it.
NEXT_PUBLIC_API_URL=http://localhost:8000

# TripTracker: where "Apri in TripTracker" sends the user (/import?plan=<id>) and, with
# NEXT_PUBLIC_AUTH_MODE=triptracker, where a 401 redirects to log in (/accedi?returnTo=<current
# page>). Production: https://viaggi.bellittim.com
NEXT_PUBLIC_TRIPTRACKER_URL=https://viaggi.bellittim.com

# Who signs the user in, the same value as the backend's AUTH_MODE (its `local` never answers 401,
# so it has no counterpart here): `atlas` sends a 401 to this app's own /login (Better Auth,
# lib/auth.ts, the server variables below); `triptracker` to TripTracker's /accedi. Empty means
# `atlas` under `next dev` and `triptracker` in any other build (the deployed default until the
# switch, so a build never fails for the lack of this one variable).
NEXT_PUBLIC_AUTH_MODE=atlas

# Development only: the offline demo's scenarios, as a comma list of backend/tests/fixtures/ma
# names (e.g. happy_path,budget_reached,mcp_failure). When set, /new shows a "Scenario demo"
# select that sends POST /plans?demo_scenario=<name> to a DEMO_MODE backend; production builds
# never show it. Leave it empty against a backend without DEMO_MODE (it answers 404).
NEXT_PUBLIC_DEMO_SCENARIOS=

# --- Accounts (NEXT_PUBLIC_AUTH_MODE=atlas; lib/auth.ts, lib/server/auth-config.ts) -----------
# Server-side only: none of these reaches the browser. Without DATABASE_URL the accounts are "not
# configured": /login says so and /api/auth/* answers 503, the rest of the app works.

# The planner's Postgres, the same database the backend migrates (`uv run alembic upgrade head`
# creates the users, auth_sessions, auth_accounts and auth_verifications tables). This one is
# backend/.env.example's, which matches docker-compose.yml; with a local Homebrew Postgres use
# postgresql://<your OS user>@localhost:5432/trip_planner_dev (node-postgres, unlike the
# backend's driver, does not fall back to the OS user when USER is unset, so name it).
# On Vercel this is Railway's public TCP proxy URL with `?uselibpqcompat=true&sslmode=require`
# (docs/deploy.md): node-postgres alone reads `sslmode=require` as verify-full, which refuses
# the proxy's self-signed certificate; `uselibpqcompat=true` gives it libpq's meaning
# (encrypted, certificate not verified).
DATABASE_URL=postgresql://trip_planner:trip_planner@localhost:5432/trip_planner_dev

# Better Auth's signing secret, at least 32 characters (`openssl rand -base64 32`). Required in
# production; development falls back to a fixed value.
BETTER_AUTH_SECRET=

# This app's public origin, the base of every callback URL (the magic link, Google's redirect).
# Production: https://atlas.bellittim.com. Development falls back to http://localhost:3000.
BETTER_AUTH_URL=http://localhost:3000

# `Domain=` of the session cookie, so the API subdomain receives it: production `bellittim.com`
# (the cookie is `__Secure-atlas.session_token`, prefix `atlas`, so it never collides with
# TripTracker's). Required in production (a host-only cookie never reaches the API host, and
# /login and the 401ing page would send the user back and forth forever); empty in development
# = host-only, which is what localhost needs.
AUTH_COOKIE_DOMAIN=

# Who may create an account without an invitation, comma separated, case insensitive: the
# bootstrap list (your own address) and, with `*`, the public launch. Everyone else needs an
# invitation on the waitlist (/admin/waitlist, the `waitlist` table). Empty means invitations
# only; accounts that already exist keep signing in. With the backend's AUTH_MODE=atlas every
# account may plan, and the backend's PLANNER_ALLOWED_EMAILS is not consulted.
AUTH_ALLOWED_EMAILS=dev@example.com

# Resend sends the magic link (https://resend.com). Required in production; empty in development
# prints the link to the server console instead, so the flow works with no account.
RESEND_API_KEY=
# The sender, on a domain verified at Resend, e.g. "Atlas <accedi@bellittim.com>".
AUTH_EMAIL_FROM=

# Google sign-in (Google Cloud > APIs & Services > Credentials > OAuth client, web application,
# redirect URI <BETTER_AUTH_URL>/api/auth/callback/google). Both or neither; without them the
# login page shows the magic link only.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Cloudflare Turnstile on the public forms (the landing's waitlist join, the login's magic-link
# request): the site key is public and drawn into the widget, the secret verifies each token on
# the server. Both or neither; without them no widget is drawn and nothing is checked (the
# development default). Cloudflare's test keys pass everything: site 1x00000000000000000000AA,
# secret 1x0000000000000000000000000000000AA.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Not read from this file: lib/server/waitlist.pg.test.ts takes WEB_TEST_DATABASE_URL from the
# shell, a scratch Postgres where it checks the invitation claim (skipped when unset, as in CI).
# WEB_TEST_DATABASE_URL=postgresql://trip_planner:trip_planner@localhost:5432/trip_planner_test_web
